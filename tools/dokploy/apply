#!/usr/bin/env python3
"""Kiki's Dokploy setup as code: Postgres, the ingester and agent apps, and their
environment variables. Replaces .railway/railway.ts and tools/railway-sync-env.

    tools/dokploy/apply                  # dry run: show what would change
    tools/dokploy/apply --apply          # create what's missing, write env, redeploy
    tools/dokploy/apply --from-railway   # take secrets from Railway's variables
                                         # instead of .env (the one-time move)

Settings that aren't secret live below and are reviewed like code. Secrets come
from the local .env (as tools/railway-sync-env did) and are never printed.
DATABASE_URL and AGENT_HOST_URL are derived from what Dokploy created, and
AGENT_HOST_TOKEN is generated once and kept. Values shared by both services are
environment-level variables, referenced as ${{environment.NAME}}.

Writing env replaces what's in Dokploy's UI for these apps: change it here (or in
.env) instead. Images are set by CI (tools/dokploy/deploy), not here.

Environment: DOKPLOY_URL (the LAN address works: http://192.168.1.38:3000) and
DOKPLOY_API_KEY, plus CF_ACCESS_CLIENT_ID/SECRET through Cloudflare Access.
See docs/self-hosting.md.
"""

import argparse
import base64
import importlib.machinery
import importlib.util
import json
import os
import secrets
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
_loader = importlib.machinery.SourceFileLoader("dokploy_deploy", str(Path(__file__).with_name("deploy")))
_spec = importlib.util.spec_from_loader("dokploy_deploy", _loader)
_deploy = importlib.util.module_from_spec(_spec)
_loader.exec_module(_deploy)
Dokploy, PROJECT, ENVIRONMENT = _deploy.Dokploy, _deploy.PROJECT, _deploy.ENVIRONMENT

SECONDS = 1_000_000_000  # Swarm durations are nanoseconds
MB = 1024 * 1024

POSTGRES = {
    "name": "postgres",
    "appName": "kiki-postgres",
    "databaseName": "kiki",
    "databaseUser": "kiki",
    # Postgres 18 + pgvector, as on Railway and in CI.
    "dockerImage": "pgvector/pgvector:pg18-trixie",
    # Dokploy mounts its volume at /var/lib/postgresql/data; Postgres 18's image
    # otherwise keeps data in /var/lib/postgresql/18/docker, outside the volume.
    "env": "PGDATA=/var/lib/postgresql/data",
    "memoryLimit": str(1024 * MB),
}

# Both apps: start the new task first, wait for its HEALTHCHECK, then stop the
# old one (the ingester's leader lock hands over, as on Railway). A task that
# never turns healthy rolls back to the previous image.
SWARM = {
    "updateConfigSwarm": {
        "Parallelism": 1,
        "Order": "start-first",
        "FailureAction": "rollback",
        "Monitor": 30 * SECONDS,
        "Delay": 0,
    },
    "rollbackConfigSwarm": {"Parallelism": 1, "Order": "start-first", "FailureAction": "pause"},
    "restartPolicySwarm": {"Condition": "any", "Delay": 5 * SECONDS, "MaxAttempts": 0},
    # SIGTERM to SIGKILL, so the ingester can save its Gateway session and
    # release the leader lock (Railway's drainingSeconds).
    "stopGracePeriodSwarm": 30 * SECONDS,
    "replicas": 1,
}

OTEL = {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp-gateway-prod-us-east-2.grafana.net/otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
}

# Environment-level, shared by both apps.
SHARED_PLAIN = {"KIKI_ENVIRONMENT": "production", **OTEL}
SHARED_SECRET = ["AGENT_HOST_TOKEN", "DISCORD_BOT_TOKEN", "OTEL_EXPORTER_OTLP_HEADERS"]

APPS = {
    "ingester": {
        "appName": "kiki-ingester",
        "memoryLimit": str(512 * MB),
        "plain": {
            "MIGRATE_ON_START": "true",
            "LOG_FORMAT": "json",
            "RUST_LOG": "info,sqlx=warn,twilight_http_ratelimiting=warn",
            "OPENROUTER_DECISION_MODEL": "~typesafe/jev-latest",
            "OPENROUTER_CHAT_MODEL": "deepseek/deepseek-v4.1-flash-1017",
            "OPENROUTER_IMAGE_MODEL": "openai/gpt-image-2.5-flare",
            "OPENROUTER_EMOJI_MODEL": "deepseek/deepseek-v4.1-flash-1017",
            "DISCORD_GUILD_IDS": "1358240830887952575,348273727298863104",
            "GITHUB_ISSUES_REPO": "carltonwu/kiki",
            "FAULT_REPORT_ENVIRONMENT": "production",
            "OTEL_SERVICE_NAME": "ingester",
        },
        "shared": ["DATABASE_URL", "AGENT_HOST_URL", *SHARED_SECRET, *SHARED_PLAIN],
        # Optional secrets: set only when the source has them.
        "secret": [
            "OPENROUTER_DECISION_API_KEY",
            "GITHUB_TOKEN",
            "GITHUB_APP_ID",
            "GITHUB_APP_INSTALLATION_ID",
            "GITHUB_APP_PRIVATE_KEY",
        ],
        # Tunables .env may override (tools/railway-sync-env's list).
        "tunable": [
            "AGENT_HISTORY_MESSAGES",
            "AGENT_HOST_TIMEOUT_MS",
            "AGENT_RUN_MAX_AGE_SECS",
            "DISCORD_GUILD_IDS",
            "JEV_MIN_CONFIDENCE",
            "JEV_TIMEOUT_MS",
            "MAX_ACTIVE_CONVERSATIONS",
            "OPENROUTER_CHAT_MODEL",
            "OPENROUTER_DECISION_MODEL",
            "OPENROUTER_EMOJI_MODEL",
            "OPENROUTER_IMAGE_MODEL",
            "OPENROUTER_TOPIC_MODEL",
            "POOL_DEBOUNCE_MS",
            "POOL_MAX_MESSAGES",
            "POOL_MAX_WAIT_MS",
            "ROUTE_ACTIVE_WINDOW_SECS",
            "ROUTE_KEYWORDS",
            "ROUTE_MAX_MESSAGE_AGE_MS",
