{
  "_comment": [
    "Grafana-managed alert rules for Kiki, applied by tools/grafana/apply (docs/observability.md, Dashboards and alerts).",
    "Rules are in the provisioning API's format. apply fills in folderUID, ruleGroup and orgID, replaces ${prom} with the",
    "Prometheus datasource's UID, and replaces ${name} with params[name] (a string that is exactly ${name} becomes the",
    "number itself). Override a param with: tools/grafana/apply --param daily_llm_spend_usd=10.",
    "No contact point is set: alerts go to the stack's default notification policy."
  ],
  "folder": {"uid": "kiki", "title": "Kiki"},
  "group": "kiki",
  "interval": "1m",
  "params": {
    "daily_llm_spend_usd": 5,
    "gateway_silence_seconds": 900,
    "run_pending_seconds": 120,
    "error_spike_count": 3,
    "postgres_memory_limit_bytes": 384000000,
    "postgres_memory_ratio": 0.9
  },
  "rules": [
    {
      "uid": "kiki-gateway-silent",
      "title": "Kiki: no Gateway events",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": "${gateway_silence_seconds}", "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "sum(increase(kiki_gateway_events_total{job=\"kiki/ingester\"}[${gateway_silence_seconds}s])) or vector(0)",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{"evaluator": {"type": "lt", "params": [1]}}]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "KeepLast",
      "for": "5m",
      "labels": {"service": "kiki", "severity": "critical"},
      "annotations": {
        "summary": "The ingester has received no Discord Gateway dispatches for ${gateway_silence_seconds} s.",
        "description": "kiki_gateway_events_total did not increase. Either the Gateway connection is down or the ingester is not running or not exporting (a missing series counts as 0, so it alerts). A very quiet guild can also go this long without a message; raise gateway_silence_seconds if it does.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    },
    {
      "uid": "kiki-run-pending",
      "title": "Kiki: agent run pending",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "max(kiki_queue_oldest_pending_age_seconds{job=\"kiki/ingester\", queue=\"agent_runs\"})",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{"evaluator": {"type": "gt", "params": ["${run_pending_seconds}"]}}]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "1m",
      "labels": {"service": "kiki", "severity": "warning"},
      "annotations": {
        "summary": "An agent run has been pending for {{ humanizeDuration $values.A.Value }}.",
        "description": "The oldest pending agent run is older than ${run_pending_seconds} s: no worker is claiming runs (agent host down or workers wedged). Runs older than AGENT_RUN_MAX_AGE_SECS expire unanswered. No data (no leader polling) is OK; the Gateway alert covers a dead ingester.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    },
    {
      "uid": "kiki-runs-stuck",
      "title": "Kiki: stuck agent runs",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "max(kiki_agent_runs_stuck{job=\"kiki/ingester\"})",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{"evaluator": {"type": "gt", "params": [0]}}]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "10m",
      "labels": {"service": "kiki", "severity": "warning"},
      "annotations": {
        "summary": "{{ $values.A.Value }} agent run(s) stuck running or delivering for over 10 minutes.",
        "description": "kiki_agent_runs_stuck has been above 0 for 10 minutes. Host requests give up after 180 s, so these runs are wedged; check the ingester logs and the agent_runs table.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    },
    {
      "uid": "kiki-daily-llm-spend",
      "title": "Kiki: daily LLM spend",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 86400, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "sum(increase(kiki_llm_cost_usd_total{job=~\"kiki/.+\"}[24h]))",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{"evaluator": {"type": "gt", "params": ["${daily_llm_spend_usd}"]}}]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "5m",
      "labels": {"service": "kiki", "severity": "warning"},
      "annotations": {
        "summary": "LLM spend over the last 24 h is ${{ printf \"%.2f\" $values.A.Value }} (threshold $${daily_llm_spend_usd}).",
        "description": "kiki_llm_cost_usd_total over a rolling 24 h, both services. See the Kiki / Cost dashboard for the purpose and model behind it.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    },
    {
      "uid": "kiki-error-spike",
      "title": "Kiki: run failures or Discord send errors",
      "condition": "D",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 900, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "sum(increase(kiki_agent_runs_finished_total{job=\"kiki/ingester\", status=~\"failed|expired\"}[15m])) or vector(0)",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {"from": 900, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "B",
            "expr": "sum(increase(kiki_discord_send_errors_total{job=\"kiki/ingester\"}[15m])) or vector(0)",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {"refId": "C", "type": "math", "expression": "$A + $B"}
        },
        {
          "refId": "D",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "D",
            "type": "threshold",
            "expression": "C",
            "conditions": [{"evaluator": {"type": "gt", "params": ["${error_spike_count}"]}}]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "5m",
      "labels": {"service": "kiki", "severity": "warning"},
      "annotations": {
        "summary": "{{ printf \"%.0f\" $values.A.Value }} failed or expired agent run(s) and {{ printf \"%.0f\" $values.B.Value }} Discord send error(s) in 15 min.",
        "description": "More than ${error_spike_count} agent run failures plus Discord send errors in 15 minutes. Interrupted runs (a restart mid-delivery) are left out so deploys don't page. See the Kiki / Pipeline dashboard.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    },
    {
      "uid": "kiki-postgres-memory",
      "title": "Kiki: Postgres memory near limit",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 600, "to": 0},
          "datasourceUid": "${prom}",
          "model": {
            "refId": "A",
            "expr": "max(kiki_railway_memory_bytes{job=\"kiki/ingester\", service=\"postgres\"}) / ${postgres_memory_limit_bytes}",
            "instant": true,
            "range": false,
            "intervalMs": 60000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{"evaluator": {"type": "gt", "params": ["${postgres_memory_ratio}"]}}]
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "KeepLast",
      "for": "10m",
      "labels": {"service": "kiki", "severity": "warning"},
      "annotations": {
        "summary": "Postgres memory is near its ${postgres_memory_limit_bytes}-byte limit{{ with $values.A }} ({{ humanizePercentage .Value }}){{ end }}.",
        "description": "kiki_railway_memory_bytes{service=\"postgres\"} has been above ${postgres_memory_ratio} of the limit for 10 minutes. Railway restarts Postgres at the limit. Without Railway metrics (no RAILWAY_METRICS_TOKEN) the rule shows No Data instead of alerting.",
        "runbook_url": "https://github.com/carltonwu/kiki/blob/main/docs/observability.md#dashboards-and-alerts"
      }
    }
  ]
}
