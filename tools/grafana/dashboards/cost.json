            "uid": "${prom}"
          },
          "expr": "sum(increase(kiki_llm_cost_usd_total{job=~\"kiki/.+\"}[$__range])) * 86400 / $__range_s",
          "legendFormat": "per day",
          "editorMode": "code",
          "instant": true,
          "range": false
