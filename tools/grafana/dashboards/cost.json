      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(increase(kiki_llm_cost_usd_total{job=~\"kiki/.+\"}[$__range]))",
          "legendFormat": "spend",
          "editorMode": "code",
          "instant": true,
          "range": false
