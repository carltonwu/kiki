{
  "uid": "kiki-logs",
  "title": "Kiki / Logs and traces",
  "description": "Loki logs per service and Tempo trace searches. Filter by level and text with the variables above.",
  "tags": [
    "kiki",
    "logs"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Kiki",
      "tags": [
        "kiki"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug,trace",
        "current": {
          "text": [
            "error",
            "warn",
            "info"
          ],
          "value": [
            "error",
            "warn",
            "info"
          ]
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "search",
        "label": "Line contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "options": [],
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume",
      "description": "Log lines per interval by service and level (detected_level).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"ingester|agent\"} | service_namespace=\"kiki\" | detected_level=~\"$level\" |~ `(?i)${search:regex}` [$__auto]))",
          "legendFormat": "{{service_name}} {{detected_level}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": -1,
            "axisSoftMin": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "Ingester",
      "description": "The ingester's tracing events (trace_id/span_id in each line's details link to Tempo).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"ingester\"} | service_namespace=\"kiki\" | detected_level=~\"$level\" |~ `(?i)${search:regex}`",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 18
      }
    },
    {
      "type": "logs",
      "title": "Agent host",
      "description": "The agent host's log lines. Their key=value text is parsed with logfmt, so details show fields like outcome, kind and cost_usd.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"agent\"} | service_namespace=\"kiki\" | detected_level=~\"$level\" |~ `(?i)${search:regex}` | logfmt",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 18
      }
    },
    {
      "type": "table",
      "title": "Recent agent runs",
      "description": "The latest agent_run spans; click a trace ID to open the whole trace (message → classify → agent run → agent host → Discord send).",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"ingester\" && name=\"agent_run\"}",
          "limit": 20,
          "spss": 3,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service.name"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Start time"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Run duration"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spanID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "agent_run span (opens the trace)"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Slow agent runs (> 20 s)",
      "description": "Agent runs that took over 20 s from claim to finish.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"ingester\" && name=\"agent_run\" && duration > 20s}",
          "limit": 20,
          "spss": 3,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service.name"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Start time"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Run duration"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spanID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "agent_run span (opens the trace)"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Traces with errors",
      "description": "Recent traces with a span in error status, from either service.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{resource.service.namespace=\"kiki\" && status=error}",
          "limit": 20,
          "spss": 3,
          "tableType": "traces",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      }
    }
  ]
}
