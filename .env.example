# Copy to .env for local development. On Railway these are set on the service.
DATABASE_URL=postgres://kiki:kiki@localhost:54329/kiki
PORT=8080
# Both services: the ingester's Discord bot; the agent host only refreshes expired
# attachment links with it (read_image, drawing references).
DISCORD_BOT_TOKEN=
# Comma-separated guilds to ingest
DISCORD_GUILD_IDS=
# Optional: OpenRouter key for Jev (Decide). Without it, Decide always answers "no".
# OPENROUTER_DECISION_API_KEY=
# OPENROUTER_DECISION_MODEL=~typesafe/jev-latest
# Server behavior defaults (overridden per server with /kiki config):
# POOL_DEBOUNCE_MS=500 POOL_MAX_WAIT_MS=8000
# POOL_MAX_MESSAGES=10 ROUTE_KEYWORDS=kiki JEV_MIN_CONFIDENCE=0.5
# MAX_ACTIVE_CONVERSATIONS=8 (active pool per server across its channels; excess evicts the least recently active)
# ROUTE_ACTIVE_WINDOW_SECS=3600 (Decide runs on every message only in channels with a conversation active this recently)
# Global routing limits (not editable through /kiki config):
# ROUTE_MAX_MESSAGE_AGE_MS=5000 JEV_TIMEOUT_MS=5000
# ROUTE_PENDING_EMOJI=👀 (reaction on messages routed to Kiki until she replies; empty disables)
# Optional: private Python host. Leave URL unset until its OpenRouter key is configured.
# AGENT_HOST_URL=http://localhost:8081
# AGENT_HOST_TOKEN= (same secret on both services; required with AGENT_HOST_URL)
# AGENT_HOST_TIMEOUT_MS=180000 (includes cold-start retries)
# OPENROUTER_CHAT_API_KEY= (Python service only; enables replies, topic summaries and embeddings)
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_TOPIC_MODEL= (current-topic summaries; defaults to OPENROUTER_CHAT_MODEL)
# OPENROUTER_VISION_MODEL= (Python service only; read_image's model, e.g. anthropic/claude-haiku-5.5. Unset: the chat model, if it reads images)
# REDDIT_CLIENT_ID= REDDIT_CLIENT_SECRET= (Python service only; read_link's Reddit reader uses app-only OAuth with them, since Reddit blocks anonymous requests from server IPs)
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-flare (generate_image tool; per-server image_model)
# OPENROUTER_EMOJI_MODEL=deepseek/deepseek-v4.1-flash-1017 (vision model for /kiki emojis resync:true)
# Rust defaults: AGENT_HISTORY_MESSAGES=30 AGENT_RUN_MAX_AGE_SECS=120 TOPIC_EVERY_MESSAGES=4
# Python defaults: PORT=8081 AGENT_HOST_MAX_CONCURRENT_JOBS=2 AGENT_HOST_JOB_TIMEOUT_SECS=120
RUST_LOG=info,sqlx=warn,twilight_http_ratelimiting=warn
# Add ,ingester=debug for routing, retries and run claims.
# LOG_LEVEL=DEBUG (Python host; defaults to INFO)
# LOG_FORMAT=json
# Telemetry (docs/observability.md). Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set.
# To see it locally: docker run -p 3000:3000 -p 4318:4318 grafana/otel-lgtm, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 (Grafana on localhost:3000).
# OTEL_SERVICE_NAME= (defaults to ingester / agent) OTEL_SDK_DISABLED=true (kill switch)
# Grafana Cloud (OTLP gateway; Stack details > OpenTelemetry). tools/railway-sync-env
# turns the ID and token into OTEL_EXPORTER_OTLP_HEADERS on Railway; they aren't synced.
# GRAFANA_CLOUD_INGESTION_URL=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
# GRAFANA_CLOUD_ID= (instance ID, numeric)
# GRAFANA_APP_TOKEN= (access policy token with metrics, logs and traces write)
# Railway project token (Project Settings > Tokens, production environment) for the
# ingester's Railway CPU/memory/network/disk gauges. Optional; only read when exporting.
# RAILWAY_METRICS_TOKEN=
